{
  "name": "@clockchain/handshake-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bilateral:console": "node bin/handshake-console.mjs",
    "bilateral:coordinator": "node bin/handshake-coordinator.mjs",
    "bilateral:bootstrap-broker": "node bin/handshake-bootstrap-broker.mjs",
    "bilateral:fund": "node scripts/fund-bilateral-addresses.mjs",
    "bilateral:public-monitor": "node scripts/publish-public-monitor.mjs",
    "bilateral:request-payment": "node bin/handshake-request-payment.mjs",
    "bilateral:relay": "node bin/handshake-relay.mjs",
    "bilateral:supervisor": "node bin/handshake-supervisor.mjs",
    "demo": "node bin/handshake-demo.mjs",
    "invitations:create": "node scripts/create-invitations.mjs",
    "invitations:check": "node scripts/check-invitations.mjs",
    "results:verify": "node scripts/verify-live-results.mjs",
    "acceptance:clients": "node scripts/run-clean-clients.mjs",
    "test": "node --test --test-concurrency=4",
    "test:unit": "node --test test/*.test.mjs",
    "verify": "npm test && npm run docs:check",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "viem": "2.55.8"
  }
}
